<xml xmlns="https://developers.google.com/blockly/xml">
  <variables><variable id="var1">count</variable></variables>
  <block type="variables_set" id="set1" x="20" y="30">
    <field name="VAR" id="var1">count</field>
    <value name="VALUE"><block type="math_number" id="n1"><field name="NUM">3</field></block></value>
    <next>
      <block type="controls_repeat_ext" id="rep1">
        <value name="TIMES">
          <shadow type="math_number" id="sh1"><field name="NUM">10</field></shadow>
          <block type="variables_get" id="get1"><field name="VAR" id="var1">count</field></block>
        </value>
        <statement name="DO">
          <block type="text_print" id="p1">
            <value name="TEXT"><shadow type="text" id="sh2"><field name="TEXT">hi</field></shadow></value>
          </block>
        </statement>
      </block>
    </next>
  </block>
</xml>
